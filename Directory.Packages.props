<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Blazilla" Version="3.0.1" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Havit.Blazor.Components.Web.Bootstrap" Version="4.29.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <PackageVersion Include="RazorEngineCore" Version="2026.1.1" />
    <PackageVersion Include="Resend" Version="0.27.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.2.0" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Selenium.Support" Version="4.54.0" />
    <PackageVersion Include="Selenium.WebDriver" Version="4.54.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>